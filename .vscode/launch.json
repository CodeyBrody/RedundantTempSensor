    "version": "0.2.0",
    "configurations": [

        {
            "name": "Debug RedundantTempSensor",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "executable": "${workspaceFolder}/build/Debug/RedundantTempSensor.elf",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "servertype": "stlink",
            "interface": "swd",
            "device": "STM32L476RGTx"
        },
        { 
            "name": "Release RedundantTempSensor", 
            "cwd": "${workspaceFolder}", 
            "request": "launch", 
            "executable": "${workspaceFolder}/build/Release/RedundantTempSensor.elf", 
            "type": "cortex-debug", 
            "runToEntryPoint": "main", 
            "showDevDebugOutput": "none", 
            "servertype": "stlink", 
            "interface": "swd", 
            "device": "STM32L476RGTx" 
        }
    ]
}