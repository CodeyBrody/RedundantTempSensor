{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake"
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "WSL-Debug",
            "inherits": "Debug",
            "binaryDir": "${sourceDir}/build-wsl/Debug"
        },
        {
            "name": "WSL-Release",
            "inherits": "Release",
            "binaryDir": "${sourceDir}/build-wsl/Release"
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "WSL-Debug",
            "configurePreset": "WSL-Debug"
        },
        {
            "name": "WSL-Release",
            "configurePreset": "WSL-Release"
        }
    ],
    "testPresets": [
        {
            "name": "WSL-Debug",
            "configurePreset": "WSL-Debug"
        }
    ]
}